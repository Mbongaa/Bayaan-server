# LiveKit Configuration
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
# Required: identical to LIVEKIT_AGENT_NAME on the classroom app (same LiveKit project).
LIVEKIT_AGENT_NAME=bayaan-translator

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key
# Translation model (optional, defaults to gpt-6-luna). Set to gpt-5.4-mini or gpt-4.1 to roll back.
# TRANSLATION_MODEL=gpt-6-luna

# Speechmatics Configuration (Optional)
SPEECHMATICS_API_KEY=your_speechmatics_api_key

# Gemini transcription (Arabic Full Dialects and the documented Gemini locales)
# Reuses the same LiveKit project above. Keep Speechmatics for Arabic Fusha old.
# Cloud model: gemini-3.5-transcribe-live-preview, global endpoint.
GEMINI_STT_BACKEND=vertex
GOOGLE_CLOUD_PROJECT=your_google_cloud_project
# Choose ONE service-account credential form. Never commit real credentials.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json
# GOOGLE_APPLICATION_CREDENTIALS_JSON={...service-account JSON...}

# Supabase Configuration
SUPABASE_URL=https://bpsahvbdlkzemwjdgxmq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_WEBHOOK_SECRET=your_webhook_secret_for_validation

# Production hardening knobs
AUDIO_STREAM_CAPACITY=100
STT_DRAIN_TIMEOUT_SECONDS=5
MAX_ACCUMULATED_CHARS=4000
MAX_ACTIVE_JOBS_PER_WORKER=9
LIVEKIT_LOAD_THRESHOLD=0.9

# WebSocket Configuration
WEBSOCKET_BRIDGE_URL=wss://bpsahvbdlkzemwjdgxmq.functions.supabase.co/functions/v1/websocket-bridge
WEBSOCKET_SERVER_PORT=8765

# Logging Level
LOG_LEVEL=INFO
